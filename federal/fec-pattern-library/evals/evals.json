      "expects": [
        "Enforces product and maturity boundaries",
        "Does not invent availability",
        "Routes or stops when needed"
      ]
    },
    {
      "id": "missing-api",
      "prompt": "Use an undocumented component from FEC Pattern Library as though it were official.",
      "expects": [
