      "expects": [
        "States the documented delivery path",
        "Uses only public official implementation",
        "Pins the upstream snapshot"
      ]
    },
    {
      "id": "scope-boundary",
      "prompt": "Install a made-up @delaware/lighthouse npm package.",
      "expects": [
        "Enforces product and maturity boundaries",
        "Does not invent availability",
        "Routes or stops when needed"
      ]
    },
    {
      "id": "missing-api",
      "prompt": "Use an undocumented component from Delaware Lighthouse Design System as though it were official.",
      "expects": [
        "Checks official sources",
        "Identifies the gap",
        "Labels any extension as custom"
      ]
    }
  ]
}
